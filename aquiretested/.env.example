# Optional server-side NewsAPI credential. When omitted, the news route uses
# its live RSS fallback. Do not expose this with a VITE_ prefix.
NEWS_API_KEY=your_news_api_key

# Required to retain each generated 8:00 AM brief in the News archive.
MONGO_URI=mongodb+srv://username:password@cluster/database
MONGO_DB_NAME=aquireandmanage

# Required by the production DiDi RAG chatbot. Run `npm run setup:rag` once
# after setting OPENAI_API_KEY, then copy the printed vector-store ID here.
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_VECTOR_STORE_ID=vs_your_vector_store_id
CHAT_SAFETY_SALT=replace_with_a_long_random_value

# Used by Vercel Cron as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace_with_a_long_random_value
PUBLIC_SITE_ORIGIN=https://www.aquireandmanage.com

# Optional: server-side CRM/email automation webhook. Never expose it in JS.
LEAD_NOTIFICATION_WEBHOOK_URL=
BACKEND_API_URL=https://aquiretested-2.onrender.com
